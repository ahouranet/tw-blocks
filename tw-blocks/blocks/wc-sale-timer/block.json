{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "tw-blocks/wc-sale-timer",
  "version": "1.0.0",
  "title": "بج تخفیف و شمارندهٔ جشنواره ووکامرس",
  "category": "tw-blocks",
  "icon": "tag",
  "description": "محاسبهٔ خودکار درصد تخفیف محصول ووکامرس به همراه تایمر معکوس جشنواره (_sale_price_dates_to)، تاریخ پایان شمسی و ارقام فارسی.",
  "keywords": ["woocommerce", "sale", "discount", "countdown", "تخفیف", "شمارنده"],
  "textdomain": "tw-blocks",
  "usesContext": ["postId", "postType"],
  "attributes": {
    "showBadge": {
      "type": "boolean",
      "default": true
    },
    "showCountdown": {
      "type": "boolean",
      "default": true
    },
    "showJalaliEndDate": {
      "type": "boolean",
      "default": true
    },
    "fallbackDiscountPercent": {
      "type": "number",
      "default": 20
    }
  },
  "supports": {
    "html": false
  },
  "editorScript": "file:../../build/editor/index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php"
}
